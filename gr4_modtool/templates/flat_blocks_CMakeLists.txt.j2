add_library({{ cmake_prefix }}_blocks_headers INTERFACE)
add_library({{ cmake_prefix }}::blocks_headers ALIAS {{ cmake_prefix }}_blocks_headers)

target_include_directories({{ cmake_prefix }}_blocks_headers INTERFACE
  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
  $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
)
target_compile_features({{ cmake_prefix }}_blocks_headers INTERFACE cxx_std_23)
target_link_libraries({{ cmake_prefix }}_blocks_headers INTERFACE ${GR4_OOT_GNURADIO4_TARGET})
install(TARGETS {{ cmake_prefix }}_blocks_headers EXPORT {{ cmake_prefix }}Targets)

install(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/{{ gr4_include_prefix }}
  DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})

file(GLOB {{ cmake_prefix }}_BLOCK_HEADERS CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/include/{{ gr4_include_prefix }}/*.hpp"
)
if({{ cmake_prefix }}_BLOCK_HEADERS)
  gr_add_block_library(
    {{ block_library_name }}
    MAKE_SHARED_LIBRARY
    HEADERS
      {{ '${' }}{{ cmake_prefix }}_BLOCK_HEADERS}
    LINK_LIBRARIES
      {{ cmake_prefix }}_blocks_headers
  )
endif()

